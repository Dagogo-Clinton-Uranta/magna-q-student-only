# Browser-safe values. NEXT_PUBLIC_APP_URL is set per environment in
# .env.development and .env.production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only values. Never prefix these with NEXT_PUBLIC_.
DEMO_AUTH_BYPASS=false
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Google Maps Embed API. Restrict this browser-visible key to approved website
# referrers and the Maps Embed API in Google Cloud.
GOOGLE_MAPS_EMBED_API_KEY=

# Stripe monthly subscription. In Stripe, create one recurring USD Price for
# exactly $100.00 every month and paste its `price_...` ID below. The secret key
# and webhook signing secret are server-only. Configure the webhook endpoint as
# `https://YOUR-DOMAIN/api/stripe/webhook`; do not use a Checkout success URL as
# proof of payment.
# Leave false to make practice tests, interview practice, and chat rooms free.
# Change to true to reinstate all page, API, socket, and Checkout paywalls.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
# Use false with test keys/local Stripe CLI, and true in production with live
# keys, Price, and webhook secret. Events from the other mode are rejected.
STRIPE_LIVE_MODE=false

# Optional provider-agnostic question assistance. The UI remains available but
# reports "not configured" until a server-only provider key is supplied.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_INTERVIEW_EVALUATION_MODEL=gpt-5.6-luna
DEEPGRAM_API_KEY=
# Private Cloudflare R2 storage for individual and mock interview recordings.
# These four values must also be available to the interview worker.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=magna-q-interview-videos
# Optional override; normally derived from the account ID above.
CLOUDFLARE_R2_ENDPOINT=

# Public feature-image uploads continue to use the separate S3 configuration.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
INTERVIEW_VIDEO_MAX_BYTES=52428800
INTERVIEW_VIDEO_RETENTION_HOURS=24
INTERVIEW_JOB_MAX_ATTEMPTS=5
INTERVIEW_JOB_BACKOFF_MS=5000
INTERVIEW_TRANSCRIPTION_CONCURRENCY=3
INTERVIEW_EVALUATION_CONCURRENCY=2
INTERVIEW_FINALIZATION_CONCURRENCY=1
# Public feature images use direct-to-S3 presigned PUT uploads. This may be a
# separate bucket from private interview recordings. The public URL can point
# to CloudFront or the bucket's public HTTPS origin (no trailing slash needed).
AWS_FEATURES_S3_BUCKET=
AWS_FEATURES_S3_PUBLIC_URL=
REDIS_URL=

# Chat rooms: MongoDB stores rooms, private membership, notifications, messages,
# and bans. A native rediss:// Redis
# URL stores short-lived socket tickets, BullMQ jobs, and the bounded stream used
# for cross-instance Vercel WebSocket delivery. Do not paste the Upstash REST
# URL here. Socket ticket TTL is bounded to 24 hours and defaults to one hour.
# Run `npm run migrate:chat` after adding MONGODB_URI to create indexes and seed
# the four initial rooms and private-group/notification indexes.
CHAT_SOCKET_AUTH_TTL_SECONDS=3600
MONGODB_URI=
MONGODB_DB_NAME=medinexus
