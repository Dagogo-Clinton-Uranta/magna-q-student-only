# Browser-safe values. Set these to the same Supabase project used by the
# Railway interview worker. Never expose the service-role key to the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only application values.
DEMO_AUTH_BYPASS=false
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Native Redis connection shared with the Railway BullMQ worker. Use the exact
# same redis:// or rediss:// URL in both deployments; do not use a REST URL and
# do not paste a second "REDIS_URL=" prefix into the value.
REDIS_URL=
INTERVIEW_JOB_MAX_ATTEMPTS=5
INTERVIEW_JOB_BACKOFF_MS=5000

# Private Cloudflare R2 storage shared with the Railway interview worker.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=magna-q-interview-videos
# Optional override; normally derived from the account ID.
CLOUDFLARE_R2_ENDPOINT=
INTERVIEW_VIDEO_MAX_BYTES=52428800
INTERVIEW_VIDEO_RETENTION_HOURS=24

# Google Maps Embed API. Restrict this browser-visible key to approved website
# referrers and the Maps Embed API in Google Cloud.
GOOGLE_MAPS_EMBED_API_KEY=

# Stripe monthly subscription.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
# One-time Stripe Prices: exactly $10 USD and $5 USD respectively.
STRIPE_INTERVIEW_COMPETENCY_PACK_PRICE_ID=
STRIPE_INTERVIEW_MOCK_PRICE_ID=
STRIPE_LIVE_MODE=false

# Optional provider-agnostic question assistance for the web application.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Public feature-image uploads use this separate S3-compatible configuration.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_FEATURES_S3_BUCKET=
AWS_FEATURES_S3_PUBLIC_URL=

# Chat rooms.
CHAT_SOCKET_AUTH_TTL_SECONDS=3600
MONGODB_URI=
MONGODB_DB_NAME=medinexus
