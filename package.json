  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:db": "bash tests/integration/verify-migrations.sh",
    "test:e2e": "playwright test",
    "worker:interviews": "tsx scripts/interview-analysis-worker.ts",
    "seed:residency-events": "tsx scripts/import-residency-events.ts",
    "migrate:chat": "tsx scripts/migrate-chat-mongodb.ts",
    "worker:chat": "tsx scripts/chat-moderation-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/functions": "^3.9.3",
    "bullmq": "^6.0.9",
    "csv-parse": "^6.1.0",
    "framer-motion": "^12.43.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.9.1",
    "next": "^15.5.21",
    "obscenity": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "stripe": "^22.5.0",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
